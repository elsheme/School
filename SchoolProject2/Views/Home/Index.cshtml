@{
    ViewData["Title"] = "لوحة التحكم | School Management";
}

<div class="container py-4">
    <!-- الترويسة الرئيسية -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
        <h1 class="display-5 fw-bold text-primary">نظام إدارة المدرسة</h1>
        <p class="lead text-muted">مرحباً بك في المنظومة التعليمية، يمكنك إدارة المعلمين، الطلاب، المواد، والفصول الدراسية بكل سهولة.</p>
    </div>

    <!-- بطاقات الوصول السريع -->
    <div class="row g-4">
        <!-- المعلمون -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-primary border-4">
                <div class="card-body text-center">
                    <div class="display-6 text-primary mb-2">👨‍🏫</div>
                    <h5 class="card-title fw-bold">المعلمون</h5>
                    <p class="card-text text-muted small">عرض قائمة المعلمين وإضافة كادر تعليمي جديد.</p>
                </div>
                <div class="card-footer bg-white border-0 d-grid gap-2 pb-3">
                    <a asp-controller="Teacher" asp-action="Index" class="btn btn-outline-primary btn-sm">عرض الكل</a>
                    <a asp-controller="Teacher" asp-action="Create" class="btn btn-primary btn-sm">إضافة معلم</a>
                </div>
            </div>
        </div>

        <!-- الطلاب -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-success border-4">
                <div class="card-body text-center">
                    <div class="display-6 text-success mb-2">🎓</div>
                    <h5 class="card-title fw-bold">الطلاب</h5>
                    <p class="card-text text-muted small">إدارة بيانات الطلاب وتسجيلهم في المقررات.</p>
                </div>
                <div class="card-footer bg-white border-0 d-grid gap-2 pb-3">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-success btn-sm">عرض الطلاب</a>
                    <a asp-controller="Student" asp-action="Register" class="btn btn-success btn-sm">تسجيل بمقرر</a>
                </div>
            </div>
        </div>

        <!-- المواد الدراسية -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-warning border-4">
                <div class="card-body text-center">
                    <div class="display-6 text-warning mb-2">📚</div>
                    <h5 class="card-title fw-bold">المواد الدراسية</h5>
                    <p class="card-text text-muted small">تنظيم المقررات، المناهج والخطط الدراسية.</p>
                </div>
                <div class="card-footer bg-white border-0 d-grid gap-2 pb-3">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-outline-warning btn-sm text-dark">عرض المقررات</a>
                    <a asp-controller="Course" asp-action="Creation" class="btn btn-warning btn-sm text-dark">إضافة مقرر</a>
                </div>
            </div>
        </div>

        <!-- الفصول / القاعات -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-info border-4">
                <div class="card-body text-center">
                    <div class="display-6 text-info mb-2">🏫</div>
                    <h5 class="card-title fw-bold">القاعات والفصول</h5>
                    <p class="card-text text-muted small">توزيع القاعات وإدارة السعة الاستيعابية.</p>
                </div>
                <div class="card-footer bg-white border-0 d-grid gap-2 pb-3">
                    <a asp-controller="Room" asp-action="Index" class="btn btn-outline-info btn-sm">عرض الفصول</a>
                    <a asp-controller="Room" asp-action="Create" class="btn btn-info btn-sm text-white">إضافة فصل</a>
                </div>
            </div>
        </div>
    </div>
</div>