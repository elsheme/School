@model SchoolProject2.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="UserId" class="form-label">User ID</label>
                <input asp-for="UserId" type="number" class="form-control" required />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GPA" class="form-label">GPA (0.0 - 4.0)</label>
                <input asp-for="GPA" type="number" step="0.01" min="0" max="4" class="form-control" />
                <span asp-validation-for="GPA" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>