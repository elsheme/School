@model IEnumerable<SchoolProject2.Models.Student>

@{
    ViewData["Title"] = "Students List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Students</h2>
    <div>
        <a asp-action="Register" class="btn btn-outline-info me-2">Register to Course</a>
        <a asp-action="Create" class="btn btn-primary">Add Student</a>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Student ID</th>
            <th>User / Name</th>
            <th>GPA</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@(item.User != null ? item.User.Name : $"User ID: {item.UserId}")</td>
                    <td>@item.GPA</td>
                    <td>
                        <button class="btn btn-sm btn-danger" onclick="deleteStudent(@item.Id)">Delete</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No students found.</td>
            </tr>
        }
    </tbody>
</table>

<script>
    function deleteStudent(id) {
        if (confirm("Are you sure you want to delete this student?")) {
            fetch('/Student/Delete/' + id, {
                method: 'DELETE'
            }).then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert("Error deleting student");
                }
            });
        }
    }
</script>