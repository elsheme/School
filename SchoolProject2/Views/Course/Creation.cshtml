@model SchoolProject2.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<h2>Create Course</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Creation" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Course Name</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">Capacity</label>
                <input asp-for="Capacity" type="number" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TeacherId" class="form-label">Teacher ID</label>
                <input asp-for="TeacherId" type="number" class="form-control" required />
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>